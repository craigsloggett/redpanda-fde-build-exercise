# Copy to .env to point the reasoner at a hosted model instead of the bundled Ollama.
# The service speaks the OpenAI chat-completions shape, so any provider that serves it works.

# Anthropic, through its OpenAI-compatible endpoint. It ignores response_format, which the service tolerates.
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=

# OpenAI: set LLM_BASE_URL=https://api.openai.com/v1 and LLM_MODEL to a model id from their model list.

# Empty means "do not download the local model". Leave it unset to keep the Ollama default.
OLLAMA_MODEL=

# Fraction of non-priority edits that reach the model, per thousand. Raise it when the model is fast.
# SAMPLE_PERMILLE=50

# Confident verdicts that are challenged anyway, per thousand, so the overturn rate has a control group.
# CHALLENGE_PERMILLE=100
